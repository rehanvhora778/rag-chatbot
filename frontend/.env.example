# Copy this file to `.env` — the dev defaults below work as-is.
#   cp frontend/.env.example frontend/.env

VITE_API_BASE_URL=http://localhost:8000

# Google (Gmail) sign-in — the OAuth 2.0 *Web application* client id from
# https://console.cloud.google.com/apis/credentials with http://localhost:3000
# listed under "Authorised JavaScript origins".
# Optional: if left blank the app falls back to GOOGLE_CLIENT_ID from backend/.env,
# and the "Continue with Google" buttons explain that it isn't configured yet.
VITE_GOOGLE_CLIENT_ID=
