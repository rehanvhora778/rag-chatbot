# Copy this file to `.env` and fill in the values marked <...>
#   cp backend/.env.example backend/.env
#
# NEVER put a real secret in this file — it is committed to git.

# ─────────────────────────────────────────
# Django Core
# ─────────────────────────────────────────
# Which settings module loads. One of: development | production | test.
# Leave blank and it is inferred from DEBUG (DEBUG=False means production).
DJANGO_ENV=development

# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Production refuses to start on the development default.
SECRET_KEY=<any-long-random-string>
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# ─────────────────────────────────────────
# Persistence
# ─────────────────────────────────────────
# Which store the domain layer reads and writes:
#   mongo    — the original MongoDB implementation
#   postgres — the Django ORM models (target architecture)
PERSISTENCE_BACKEND=mongo

# Set this and Django's `default` database becomes PostgreSQL — and with it
# PERSISTENCE_BACKEND, VECTOR_BACKEND and RAG_HYBRID_ENABLED all default to the
# upgraded stack. Leave it blank and SQLite is used, which is what the project
# has always done. Docker Compose sets this for you.
#
#   local docker   postgresql://raguser:ragpass@localhost:5432/ragchatbot
#   Neon (hosted)  postgresql://user:pass@ep-xxx.c-2.REGION.aws.neon.tech/neondb?sslmode=require
#
# On Neon, use the DIRECT endpoint — NOT the one with `-pooler` in the host —
# and keep `?sslmode=require`. psycopg 3 uses server-side prepared statements,
# which pgBouncer in transaction mode breaks intermittently. See DEPLOYMENT.md,
# Option B, for the full reasoning and the option that would make pooling safe.
DATABASE_URL=

# MongoDB — used while PERSISTENCE_BACKEND=mongo.
MONGODB_HOST=mongodb://localhost:27017
MONGODB_DB=ragchatbot

# ─────────────────────────────────────────
# Redis — Celery broker/results, and the cache when CACHE_ENABLED=True
# ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=False
# Run tasks inline instead of dispatching them — no worker needed.
CELERY_TASK_ALWAYS_EAGER=False

# ─────────────────────────────────────────
# CORS
# ─────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─────────────────────────────────────────
# Google (Gmail) sign-in
# Create an "OAuth 2.0 Client ID" of type "Web application" at
# https://console.cloud.google.com/apis/credentials and add
# http://localhost:3000 under "Authorised JavaScript origins".
# Put the SAME id in frontend/.env as VITE_GOOGLE_CLIENT_ID.
# Leave blank to hide the "Continue with Google" buttons.
# ─────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ─────────────────────────────────────────
# Email — sends the one-time codes for sign-up and password reset.
# Leave EMAIL_HOST_USER blank and the codes are printed in the runserver
# terminal instead of being mailed (fine for a local demo).
# For real Gmail delivery: turn on 2-Step Verification, then create an
# App Password at https://myaccount.google.com/apppasswords and paste the
# 16 characters below (spaces are fine).
# ─────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=RAG Chatbot <no-reply@localhost>

# ─────────────────────────────────────────
# Brevo — REQUIRED IN PRODUCTION on Render.
# Render's free instances have no outbound SMTP: smtp.gmail.com:587 fails with
# "[Errno 101] Network is unreachable" however correct the App Password is.
# Brevo's transactional API is plain HTTPS, which is not blocked.
# Set this and it takes precedence over the SMTP settings above.
#   1. https://app.brevo.com  ->  SMTP & API  ->  API Keys  ->  Generate
#   2. Senders & IPs -> add and verify the address you send FROM
#   3. DEFAULT_FROM_EMAIL above must use that verified address
# Leave blank for local development — SMTP (or the console) is used instead.
# ─────────────────────────────────────────
BREVO_API_KEY=

# ─────────────────────────────────────────
# OTP behaviour
# ─────────────────────────────────────────
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=6
OTP_RESET_TOKEN_TTL_MINUTES=15

# ─────────────────────────────────────────
# Seed administrator — created by `python manage.py create_admin`
#
# There is NO default password. Set one here, or run
#   python manage.py create_admin --generate-password
# and the command prints a strong one once.
# ─────────────────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=Administrator

# ─────────────────────────────────────────
# LLM provider
# 'groq' is the implemented adapter. Others plug into the same registry.
# Free Groq key from https://console.groq.com/keys
# ─────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_OUTPUT_TOKENS=2048
GROQ_TEMPERATURE=0.2

# Reads scanned PDF pages as images (OCR). Most Groq models are text-only and
# will reject images — check https://console.groq.com/docs/models before changing.
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# ─────────────────────────────────────────
# Embeddings
# ─────────────────────────────────────────
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BACKEND=onnx
EMBEDDING_ONNX_PROVIDER=auto
EMBEDDING_PRELOAD=True

# ─────────────────────────────────────────
# Vector store
#   faiss    — per-user on-disk index files (the original)
#   pgvector — vectors stored beside their chunks in PostgreSQL
# ─────────────────────────────────────────
VECTOR_BACKEND=faiss

# ─────────────────────────────────────────
# RAG Pipeline
# ─────────────────────────────────────────
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=6
RAG_FETCH_K=24
RAG_USE_MMR=True
RAG_MMR_LAMBDA=0.7
RAG_MIN_SIMILARITY_SCORE=0.2
RAG_DEBUG=False
CONVERSATION_MEMORY_TURNS=5
RAG_MAX_CONTEXT_CHARS=12000

# ─────────────────────────────────────────
# Hybrid retrieval — needs PERSISTENCE_BACKEND=postgres and
# VECTOR_BACKEND=pgvector (the keyword half is a PostgreSQL full-text index).
# A system check refuses to start if that is not the case, rather than letting
# retrieval quietly fall back to vector-only.
#
# Measured on the sample corpus with `manage.py evaluate_rag` (21 cases):
#
#   config                          recall  precision   MRR   ctx relevance
#   dense only, top_k=6              1.000     0.220    0.969     0.660
#   + keyword + RRF, top_k=6         1.000     0.210    1.000     0.704
#   + cross-encoder rerank, top_k=3  1.000     0.365    1.000     0.833
#
# Two things that table shows and a single number would not:
#
#   Hybrid alone fixes ranking, not precision. MRR reaching 1.000 means the
#   correct page is now first for every answerable question — the keyword half
#   finds exact strings ("Revision 7.2") that dense retrieval misses entirely.
#
#   Precision only moves once top_k comes down, and reranking is what makes
#   that safe: at top_k=3 WITHOUT reranking, recall falls to 0.969 — a correct
#   passage is lost. With it, recall stays at 1.000 while precision nearly
#   doubles. That is the whole argument for a reranker.
#
# Reranking needs the PyTorch stack (requirements.txt, not requirements-prod.txt,
# where PyTorch alone is ~800 MB). Without it the pipeline keeps fusion order
# and says so in the log rather than pretending it reranked.
# ─────────────────────────────────────────
RAG_HYBRID_ENABLED=False
RAG_KEYWORD_TOP_K=24
RAG_RRF_K=60
RAG_RERANK_ENABLED=False
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Rewrites a follow-up ("what about international purchases?") into a standalone
# question BEFORE retrieval sees it. Without this the retriever gets the words
# the user typed and nothing else, so the passage they are obviously asking
# about may never be retrieved — the model then answers from whatever did come
# back, and it reads as a reasoning failure rather than a retrieval one.
# Costs one extra LLM call per follow-up; skipped on the first turn and on
# questions that already stand alone.
RAG_QUERY_REWRITE=False

# ─────────────────────────────────────────
# Rate limits (DRF format: "<count>/<period>")
# ─────────────────────────────────────────
CHAT_THROTTLE_RATE=20/min
UPLOAD_THROTTLE_RATE=30/hour
AUTH_THROTTLE_RATE=10/min

# ─────────────────────────────────────────
# File Upload
# ─────────────────────────────────────────
MAX_DOCUMENT_SIZE_MB=50
MAX_DOCUMENTS_PER_USER=50

# ─────────────────────────────────────────
# Logging
# ─────────────────────────────────────────
DJANGO_LOG_LEVEL=INFO
