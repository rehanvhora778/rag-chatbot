# Copy this file to `.env` and fill in the values marked <...>
#   cp backend/.env.example backend/.env

# ─────────────────────────────────────────
# Django Core
# ─────────────────────────────────────────
SECRET_KEY=<any-long-random-string>
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# ─────────────────────────────────────────
# MongoDB
# ─────────────────────────────────────────
MONGODB_HOST=mongodb://localhost:27017
MONGODB_DB=ragchatbot

# ─────────────────────────────────────────
# CORS
# ─────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─────────────────────────────────────────
# Groq LLM (primary — used for all chat & summaries)
# Free key from https://console.groq.com/keys
# ─────────────────────────────────────────
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_OUTPUT_TOKENS=1024
GROQ_TEMPERATURE=0.2

# ─────────────────────────────────────────
# Gemini (not used — leave blank)
# ─────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TEMPERATURE=0.2

# ─────────────────────────────────────────
# Embeddings
# ─────────────────────────────────────────
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ─────────────────────────────────────────
# RAG Pipeline
# ─────────────────────────────────────────
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=4
RAG_FETCH_K=20
RAG_USE_MMR=True
RAG_MMR_LAMBDA=0.7
RAG_MIN_SIMILARITY_SCORE=0.2
RAG_DEBUG=False
CONVERSATION_MEMORY_TURNS=5
# Per-user rate limit on the chat endpoint (DRF format: "<count>/<period>").
CHAT_THROTTLE_RATE=20/min

# ─────────────────────────────────────────
# File Upload
# ─────────────────────────────────────────
MAX_DOCUMENT_SIZE_MB=50

# ─────────────────────────────────────────
# Logging
# ─────────────────────────────────────────
DJANGO_LOG_LEVEL=INFO
