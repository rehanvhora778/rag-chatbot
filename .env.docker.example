# ============================================================
# Docker Compose environment
# ============================================================
#   cp .env.docker.example .env
#   docker compose up --build
#
# Compose reads `.env` from this directory automatically. It configures the
# STACK (ports, database credentials); backend/.env configures the Django app
# when you run it outside Docker. The two do not read each other.

# ─────────────────────────────────────────
# Ports on the host. Change any that clash with something already running.
# ─────────────────────────────────────────
API_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
MONGO_PORT=27017

# ─────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=ragchatbot

# ─────────────────────────────────────────
# Django
# ─────────────────────────────────────────
# Fine for local development. docker-compose.prod.yml requires a real one.
SECRET_KEY=dev-only-secret-not-for-production

# mongo | postgres — which store the domain layer uses.
PERSISTENCE_BACKEND=mongo
# faiss | pgvector
VECTOR_BACKEND=faiss
MONGODB_DB=ragchatbot

# ─────────────────────────────────────────
# LLM — the one value you actually have to supply.
# Free key from https://console.groq.com/keys
# ─────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ─────────────────────────────────────────
# Google sign-in (optional — blank hides the button)
# ─────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ─────────────────────────────────────────
# Seed administrator. Leave the password blank and no admin is created;
# `docker compose exec api python manage.py create_admin --generate-password`
# creates one and prints a strong password.
# ─────────────────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=
